digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.48", ranksep="0.68", fontname="Arial", fontsize=22, fontcolor="#142d4e", labelloc=t, label="ER diagram — all 13 declared tables", splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#f0f6fc", color="#53769d", fontname="Arial", fontsize=13, fontcolor="#173454", margin="0.18,0.12", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#637991", fontcolor="#344e68", arrowsize=0.7, penwidth=1.1];
subject_courses [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>subject_courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK subject_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK course_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">is_active</TD></TR></TABLE> >];
subject -> subject_courses [dir=both,arrowtail=teetee,arrowhead=crowodot,tooltip="subject_id -> subject.id"];
course -> subject_courses [dir=both,arrowtail=teetee,arrowhead=crowodot,tooltip="course_id -> course.id"];
institute [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>institute</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">UK institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">UK admin_email</TD></TR></TABLE> >];
teacher [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>teacher</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK institute_id ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">teacher_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">UK email</TD></TR></TABLE> >];
institute -> teacher [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="institute_id -> institute.id"];
course [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>course</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK institute_id ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">class_id</TD></TR></TABLE> >];
institute -> course [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="institute_id -> institute.id"];
subject [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>subject</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK institute_id ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK teacher_id_fk ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">subject_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">class_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">teacher_id</TD></TR></TABLE> >];
institute -> subject [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="institute_id -> institute.id"];
teacher -> subject [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="teacher_id_fk -> teacher.id"];
timetable [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>timetable</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK institute_id ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK course_id_fk ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK teacher_id_fk ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK subject_id_fk ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">session_group_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">specific_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK leave_id ?</TD></TR></TABLE> >];
institute -> timetable [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="institute_id -> institute.id"];
course -> timetable [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="course_id_fk -> course.id"];
teacher -> timetable [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="teacher_id_fk -> teacher.id"];
subject -> timetable [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="subject_id_fk -> subject.id"];
teacher_leave -> timetable [dir=both,arrowtail=teeodot,arrowhead=crowodot,tooltip="leave_id -> teacher_leave.id"];
settings [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">key</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">value</TD></TR></TABLE> >];
student [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>student</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">UK email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">class_id</TD></TR></TABLE> >];
teacher_update_request [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>teacher_update_request</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">teacher_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">status</TD></TR></TABLE> >];
academic_calendar [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>academic_calendar</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">is_holiday</TD></TR></TABLE> >];
teacher_leave [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>teacher_leave</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">teacher_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">status</TD></TR></TABLE> >];
notification [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>notification</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">user_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">user_id</TD></TR></TABLE> >];
generation_history [shape=plain,label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6d87a3"><TR><TD BGCOLOR="#173454"><FONT COLOR="white"><B>generation_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">PK id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">FK institute_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">institute_code</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7fb">status</TD></TR></TABLE> >];
institute -> generation_history [dir=both,arrowtail=teetee,arrowhead=crowodot,tooltip="institute_id -> institute.id"];
subgraph cluster_legacy {label="No declared foreign keys on these five tables"; color="#c5b089"; style=dashed;
 student; settings; academic_calendar; teacher_update_request; notification;}
 institute -> student [style=invis];
}
