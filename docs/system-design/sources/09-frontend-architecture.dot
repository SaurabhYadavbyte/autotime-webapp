digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.48", ranksep="0.68", fontname="Arial", fontsize=22, fontcolor="#142d4e", labelloc=t, label="Frontend architecture — server-rendered pages with JavaScript", splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#f0f6fc", color="#53769d", fontname="Arial", fontsize=13, fontcolor="#173454", margin="0.18,0.12", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#637991", fontcolor="#344e68", arrowsize=0.7, penwidth=1.1];

 route [label="Flask route handlers
render_template(context)",fillcolor="#e6f5ed"];
 base [label="Jinja shared/base.html
Role navigation; theme; CSRF meta; flash UI"];
