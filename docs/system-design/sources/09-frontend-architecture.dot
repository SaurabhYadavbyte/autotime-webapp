Generation fetch; class lookup
slot forms; PDF export"];
 api [label="JSON endpoints
/api/generate_timetable
/api/get_classes/<inst_code>
/api/get_slot_data"];
 styles [label="static/style.css + loader.css
Responsive layouts and styling"];
