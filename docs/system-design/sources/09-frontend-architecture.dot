auth / admin / teacher / student / shared"];
 component [label="Reusable components
public_navbar.html
Timetable view-model: days_data"];
 browser [label="Browser DOM",fillcolor="#fff1dc"];
 ui [label="Bootstrap 5 + icons + Inter
